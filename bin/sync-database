#!/usr/bin/env bash
set -euo pipefail
STOCKDEPTH_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STOCKDEPTH_RUNTIME_BIN="${STOCKDEPTH_RUNTIME_BIN:-$(python3 - "$STOCKDEPTH_ROOT/.env" <<'PY'
import sys
from pathlib import Path
for line in Path(sys.argv[1]).read_text().splitlines():
    if line.startswith('STOCKDEPTH_RUNTIME_BIN='):
        print(line.split('=', 1)[1].strip().strip('\"').strip("'"))
        break
PY
)}"
if [[ -z "$STOCKDEPTH_RUNTIME_BIN" || ! -x "$STOCKDEPTH_RUNTIME_BIN/python" ]]; then
  echo 'Configure STOCKDEPTH_RUNTIME_BIN in .env first.' >&2
  exit 1
fi
exec "$STOCKDEPTH_RUNTIME_BIN/python" "$STOCKDEPTH_ROOT/scripts/sync-database.py" "$@"
