STOCKDEPTH_RUNTIME_BIN=/path/to/conda/envs/stockdepth/bin
# All services use this one root configuration file.
POSTGRES_URL=postgresql://user:password@127.0.0.1:5432/saas_starter
BASE_URL=http://localhost:3000
AUTH_SECRET=replace-with-random-secret
# Create an initial administrator when no administrator exists; existing passwords are preserved.
STOCKDEPTH_ADMIN_EMAIL=test@test.com
STOCKDEPTH_ADMIN_PASSWORD=change-me-before-first-start
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STOCKDEPTH_API_URL=http://127.0.0.1:8008
STOCKDEPTH_API_USERNAME=admin
STOCKDEPTH_API_PASSWORD=change-me
STOCKDEPTH_WEB_HOST=127.0.0.1
STOCKDEPTH_WEB_PORT=8008
STOCKDEPTH_WEB_USERNAME=admin
STOCKDEPTH_WEB_PASSWORD=change-me
ANALYSIS_WORKER_POLL_MS=5000
ANALYSIS_WORKER_RUN_TIMEOUT_MS=5400000
ANALYSIS_WORKER_STALL_TIMEOUT_MS=1200000
ANALYSIS_WORKER_HARD_TIMEOUT_MS=10800000
ANALYSIS_WORKER_MOCK=false
ANALYSIS_WORKER_MAX_CONCURRENCY=4
# Model provider, endpoint, names and keys are managed in the database.
