STOCKDEPTH_RUNTIME_BIN=/path/to/conda/envs/stockdepth/bin
# All services use this one root configuration file.
POSTGRES_URL=postgresql://user:password@127.0.0.1:5432/stockdepth_dev
BASE_URL=http://localhost:3000
AUTH_SECRET=replace-with-random-secret
# Create an initial administrator when no administrator exists; existing passwords are preserved.
STOCKDEPTH_ADMIN_EMAIL=test@test.com
STOCKDEPTH_ADMIN_PASSWORD=change-me-before-first-start
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STOCKDEPTH_API_URL=http://127.0.0.1:8008
STOCKDEPTH_API_USERNAME=admin
STOCKDEPTH_API_PASSWORD=change-me
STOCKDEPTH_WEB_HOST=127.0.0.1
STOCKDEPTH_WEB_PORT=8008
STOCKDEPTH_WEB_USERNAME=admin
STOCKDEPTH_WEB_PASSWORD=change-me
ANALYSIS_WORKER_POLL_MS=5000
ANALYSIS_WORKER_RUN_TIMEOUT_MS=5400000
ANALYSIS_WORKER_STALL_TIMEOUT_MS=1200000
ANALYSIS_WORKER_HARD_TIMEOUT_MS=10800000
ANALYSIS_WORKER_MOCK=false
# Model provider, endpoint, names and keys are managed in the database.

# Local OpenTelemetry latency traces (no prompts, headers or SQL text).
STOCKDEPTH_TRACE_LOCAL=false

# Per-process database pool; web and each worker share one pool within their process.
STOCKDEPTH_DB_POOL_SIZE=5
# Set false only for a connection proxy that cannot support prepared statements.
STOCKDEPTH_DB_PREPARE=true
# Task concurrency is configured in Admin > System, not environment variables.
ANALYSIS_WORKER_MIN_AVAILABLE_MB=256
# Shared host-wide gate for initial model invocations; optional provider override:
# STOCKDEPTH_PROVIDER_DEEPSEEK_RPM=30
STOCKDEPTH_PROVIDER_RPM=60
STOCKDEPTH_MODEL_MAX_RETRIES=2
# Analyst parallelism per new run: 1, 2 or 4; capped by Quick model's
# request_concurrency snapshot (missing capacity defaults to 4).
STOCKDEPTH_ANALYST_CONCURRENCY=4
# Maximum tool rounds per analyst, followed by one final report attempt (1..20).
STOCKDEPTH_MAX_TOOL_ROUNDS=5

# Shared catalogue market Worker; explicitly start with ./bin/stockdepth start market.
# No model calls. Claims only enabled instruments; caps: batch100/provider4/init500.
MARKET_SYNC_BATCH_SIZE=10
MARKET_PROVIDER_CONCURRENCY=2
MARKET_WORKER_POLL_MS=60000
# Explicit one-time --initialize-catalog only, not recurring discovery.
MARKET_CATALOG_INIT_LIMIT=100

# Independent model-key encryption material; generate locally, never commit or print.
# Missing material blocks encrypted reads/new key saves before any provider call.
# Keyring JSON maps IDs to independent random 32-byte base64url keys.
# Retain old IDs/material during rotation and restore; do not derive from AUTH_SECRET/API keys.
STOCKDEPTH_MODEL_KEY_ID=
STOCKDEPTH_MODEL_KEYRING=
# Example format ONLY: {"v1":"<random-32-byte-base64url>"}
# Keep .env mode600. Verify all web/analysis/paper readers before explicit encryption.
# STOCKDEPTH_MODEL_READERS_READY is a per-invocation readiness assertion, not a persistent default.
# Historical retention stays dry-run; production automatic cleanup is disabled.

# Registration email verification (QQ SMTP authorization code, not mailbox password)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
EMAIL_SENDER=
SMTP_AUTH_CODE=

# Optional daily mirror to a dedicated remote backup database (same DB credentials).
# Run ./bin/sync-database --check before enabling the systemd timer.
DATABASE_SYNC_HOST=
DATABASE_SYNC_PORT=5432
DATABASE_SYNC_DATABASE=stockdepth
DATABASE_SYNC_RETENTION_DAYS=14
# Direct PostgreSQL connections always verify TLS. Supply a trusted CA/cert path.
DATABASE_SYNC_SSLROOTCERT=
# Alternatively use verified SSH key login; DB connects to remote loopback via SSH.
DATABASE_SYNC_SSH_USER=
DATABASE_SYNC_SSH_HOST=
DATABASE_SYNC_SSH_PORT=22
DATABASE_SYNC_SSH_KEY=
